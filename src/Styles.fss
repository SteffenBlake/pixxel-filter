/* Shown for emergency pickups, with minimal visual noise.
   Keep some opacity: fully transparent labels would be impossible to find. */
scroll-tier {
    show: true;
    font-size: 1;
    font-color: transparent;
    border-color: black;
    bg-color: transparent;
    icon-size: 2;
    icon-shape: UpsideDownHouse;
    pillar: disabled;
    alert: disabled;
    drop-sound: disabled;
}

portal-scroll {
    icon-color: Brown;
    bg-color: 0x452004;
}

wisdom-scroll {
    icon-color: Green;
    bg-color: 0x327E32;
}

gold {
    icon-color: Yellow;
    bg-color: 0xFFA600;
}
