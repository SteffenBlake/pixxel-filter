    show: false;
    font-size: 33;
    font-color: 0xFFFFFF;
    font-color-alpha: 150;
    border-color: 0xFFFFFF;
    border-color-alpha: 150;
    bg-color: 0x10738D;
    bg-color-alpha: 150;
    icon: enabled;
    icon-size: 2;
    icon-color: Cyan;
    pillar: enabled;
    pillar-color: Cyan;
    pillar-duration: Temporary;
    alert: 3 200;
}

valuable-tier {
    show: true;
    font-size: 36;
    font-color: 0xFFFFFF;
    border-color: 0xFFFFFF;
    bg-color: 0x0784B5;
    icon: enabled;
    icon-size: 1;
    icon-color: Cyan;
    pillar: enabled;
    pillar-color: Cyan;
    pillar-duration: Permanent;
    alert: 5 200;
}

premium-tier {
    show: true;
    font-size: 39;
    font-color: 0xFFFFFF;
    border-color: 0xFFFFFF;
    bg-color: 0x4861A5;
    icon: enabled;
    icon-size: 1;
    icon-color: Blue;
    pillar: enabled;
    pillar-color: Blue;
    pillar-duration: Permanent;
    alert: 1 200;
}

exceptional-tier {
    show: true;
    font-size: 42;
    font-color: 0xFFFFFF;
    border-color: 0xFFFFFF;
    bg-color: 0x583A94;
    icon: enabled;
    icon-size: 1;
    icon-color: Purple;
    pillar: enabled;
    pillar-color: Purple;
    pillar-duration: Permanent;
    alert: 1 300;
}

divine-tier {
    show: true;
    font-size: 45;
    font-color: 0xFFFFFF;
    border-color: 0xFFFFFF;
    bg-color: 0x583A94;
    icon: enabled;
    icon-size: 0;
    icon-color: Pink;
    pillar: enabled;
    pillar-color: Pink;
    pillar-duration: Permanent;
    alert: 6 200;
}

mirror-tier {
    show: true;
    font-size: 45;
    font-color: 0xFFFFFF;
    border-color: 0xFFFFFF;
    bg-color: 0x583A94;
    icon: enabled;
    icon-size: 0;
    icon-color: White;
    pillar: enabled;
