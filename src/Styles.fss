/* Label backgrounds use the sampled palette and approved OKLab midpoint.
   Icon shapes come from Icons.fss; tiers supply size and matching icon/beam colors.
   Icon size 0 is largest. */

hidden {
    show: false;
    icon: disabled;
    pillar: disabled;
    alert: disabled;
    drop-sound: disabled;
}

trash-tier {
    show: false;
    font-size: 20;
    font-color: 0xFFFFFF;
    font-color-alpha: 150;
    border-color: 0xFFFFFF;
    border-color-alpha: 150;
    bg-color: 0x392718;
    bg-color-alpha: 150;
    icon: enabled;
    icon-size: 2;
    icon-color: Brown;
    pillar: enabled;
    pillar-color: Brown;
    pillar-duration: Temporary;
    alert: disabled;
}

junk-tier {
    show: false;
    font-size: 23;
    font-color: 0xFFFFFF;
    font-color-alpha: 150;
    border-color: 0xFFFFFF;
    border-color-alpha: 150;
    bg-color: 0x563D28;
    bg-color-alpha: 150;
    icon: enabled;
    icon-size: 2;
    icon-color: Brown;
    pillar: enabled;
    pillar-color: Brown;
    pillar-duration: Temporary;
    alert: disabled;
}

meh-tier {
    show: false;
    font-size: 26;
    font-color: 0xFFFFFF;
    font-color-alpha: 150;
    border-color: 0xFFFFFF;
    border-color-alpha: 150;
    bg-color: 0x4D4A3F;
    bg-color-alpha: 150;
    icon: enabled;
    icon-size: 2;
    icon-color: Grey;
    pillar: enabled;
    pillar-color: Grey;
    pillar-duration: Temporary;
    alert: 11 100;
}

common-tier {
    show: false;
    font-size: 29;
    font-color: 0xFFFFFF;
    font-color-alpha: 150;
    border-color: 0xFFFFFF;
    border-color-alpha: 150;
    bg-color: 0x1C586F;
    bg-color-alpha: 150;
    icon: enabled;
    icon-size: 2;
    icon-color: Grey;
    pillar: enabled;
    pillar-color: Grey;
    pillar-duration: Temporary;
    alert: 12 100;
}

