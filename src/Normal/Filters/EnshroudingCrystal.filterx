[
    Style currency;
    { HasValue %JunkTier_EnshroudingCrystal%; BaseType == %JunkTier_EnshroudingCrystal%; Style junk-tier; }
    {
        HasValue %CommonTier_EnshroudingCrystal%; BaseType == %CommonTier_EnshroudingCrystal%; Style common-tier;
        { StackSize >= 10; Style useful-tier; }
    }
    {
        HasValue %UsefulTier_EnshroudingCrystal%; BaseType == %UsefulTier_EnshroudingCrystal%; Style useful-tier;
        {
            StackSize >= 5; Style valuable-tier;
            { StackSize >= 15; Style premium-tier; }
        }
    }
    {
        HasValue %ValuableTier_EnshroudingCrystal%; BaseType == %ValuableTier_EnshroudingCrystal%; Style valuable-tier;
        {
            StackSize >= 3; Style premium-tier;
            { StackSize >= 10; Style exceptional-tier; }
        }
    }
    {
        HasValue %PremiumTier_EnshroudingCrystal%; BaseType == %PremiumTier_EnshroudingCrystal%; Style premium-tier;
        {
            StackSize >= 4; Style exceptional-tier;
            { StackSize >= 7; Style divine-tier; }
        }
    }
    {
        HasValue %ExceptionalTier_EnshroudingCrystal%; BaseType == %ExceptionalTier_EnshroudingCrystal%; Style exceptional-tier;
        {
            StackSize >= 2; Style divine-tier;
            { StackSize >= 20; Style mirror-tier; }
        }
    }
    {
        HasValue %DivineTier_EnshroudingCrystal%; BaseType == %DivineTier_EnshroudingCrystal%; Style divine-tier;
        { StackSize >= 10; Style mirror-tier; }
    }
    { HasValue %MirrorTier_EnshroudingCrystal%; BaseType == %MirrorTier_EnshroudingCrystal%; Style mirror-tier; }
]
