# Splinters can reach 300. Still promote by no more than two tiers.
# Both exchange categories can contain splinters; intersect their tier lists
# with the partial BaseType match rather than creating more JSON variables.
[
    BaseType = Splinter;
    Style fragment;
    {
        HasValue %JunkTier_Currency% %JunkTier_Fragment%;
        BaseType == %JunkTier_Currency% %JunkTier_Fragment%;
        Style junk-tier;
    }
    {
        HasValue %CommonTier_Currency% %CommonTier_Fragment%;
        BaseType == %CommonTier_Currency% %CommonTier_Fragment%;
        Style common-tier;
        {
            StackSize >= 10;
            Style useful-tier;
            { StackSize >= 50; Style valuable-tier; }
        }
    }
    {
        HasValue %UsefulTier_Currency% %UsefulTier_Fragment%;
        BaseType == %UsefulTier_Currency% %UsefulTier_Fragment%;
        Style useful-tier;
        {
            StackSize >= 5;
            Style valuable-tier;
            { StackSize >= 15; Style premium-tier; }
        }
    }
    {
        HasValue %ValuableTier_Currency% %ValuableTier_Fragment%;
        BaseType == %ValuableTier_Currency% %ValuableTier_Fragment%;
        Style valuable-tier;
        {
            StackSize >= 3;
            Style premium-tier;
            { StackSize >= 10; Style exceptional-tier; }
        }
    }
    {
        HasValue %PremiumTier_Currency% %PremiumTier_Fragment%;
        BaseType == %PremiumTier_Currency% %PremiumTier_Fragment%;
        Style premium-tier;
        {
            StackSize >= 4;
            Style exceptional-tier;
            { StackSize >= 7; Style divine-tier; }
        }
    }
    {
        HasValue %ExceptionalTier_Currency% %ExceptionalTier_Fragment%;
        BaseType == %ExceptionalTier_Currency% %ExceptionalTier_Fragment%;
        Style exceptional-tier;
        {
            StackSize >= 2;
            Style divine-tier;
            { StackSize >= 20; Style mirror-tier; }
        }
    }
    {
        HasValue %DivineTier_Currency% %DivineTier_Fragment%;
        BaseType == %DivineTier_Currency% %DivineTier_Fragment%;
        Style divine-tier;
        { StackSize >= 10; Style mirror-tier; }
    }
    {
        HasValue %MirrorTier_Currency% %MirrorTier_Fragment%;
        BaseType == %MirrorTier_Currency% %MirrorTier_Fragment%;
        Style mirror-tier;
    }
]
