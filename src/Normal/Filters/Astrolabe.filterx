[
    Style map;
    {
        HasValue %MehTier_Astrolabe%;
        BaseType == %MehTier_Astrolabe%;
        Style meh-tier;
    }
    {
        HasValue %CommonTier_Astrolabe%;
        BaseType == %CommonTier_Astrolabe%;
        Style common-tier;
        {
            StackSize >= 10;
            Style useful-tier;
        }
    }
    {
        HasValue %UsefulTier_Astrolabe%;
        BaseType == %UsefulTier_Astrolabe%;
        Style useful-tier;
        {
            StackSize >= 5;
            Style valuable-tier;
            {
                StackSize >= 15;
                Style premium-tier;
            }
        }
    }
    {
        HasValue %ValuableTier_Astrolabe%;
        BaseType == %ValuableTier_Astrolabe%;
        Style valuable-tier;
        {
            StackSize >= 3;
            Style premium-tier;
            {
                StackSize >= 10;
                Style exceptional-tier;
            }
        }
    }
    {
        HasValue %PremiumTier_Astrolabe%;
        BaseType == %PremiumTier_Astrolabe%;
        Style premium-tier;
        {
            StackSize >= 4;
            Style exceptional-tier;
            {
                StackSize >= 7;
                Style divine-tier;
            }
        }
    }
    {
        HasValue %ExceptionalTier_Astrolabe%;
        BaseType == %ExceptionalTier_Astrolabe%;
        Style exceptional-tier;
        {
            StackSize >= 2;
            Style divine-tier;
            {
                StackSize >= 20;
                Style mirror-tier;
            }
        }
    }
    {
        HasValue %DivineTier_Astrolabe%;
        BaseType == %DivineTier_Astrolabe%;
        Style divine-tier;
        {
            StackSize >= 10;
            Style mirror-tier;
        }
    }
    {
        HasValue %MirrorTier_Astrolabe%;
        BaseType == %MirrorTier_Astrolabe%;
        Style mirror-tier;
    }
]
