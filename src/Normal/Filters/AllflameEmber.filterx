[
    Style currency;
    { HasValue %JunkTier_AllflameEmber%; BaseType == %JunkTier_AllflameEmber%; Style junk-tier; }
    {
        HasValue %CommonTier_AllflameEmber%; BaseType == %CommonTier_AllflameEmber%; Style common-tier;
        { StackSize >= 10; Style useful-tier; }
    }
    {
        HasValue %UsefulTier_AllflameEmber%; BaseType == %UsefulTier_AllflameEmber%; Style useful-tier;
        {
            StackSize >= 5; Style valuable-tier;
            { StackSize >= 15; Style premium-tier; }
        }
    }
    {
        HasValue %ValuableTier_AllflameEmber%; BaseType == %ValuableTier_AllflameEmber%; Style valuable-tier;
        {
            StackSize >= 3; Style premium-tier;
            { StackSize >= 10; Style exceptional-tier; }
        }
    }
    {
        HasValue %PremiumTier_AllflameEmber%; BaseType == %PremiumTier_AllflameEmber%; Style premium-tier;
        {
            StackSize >= 4; Style exceptional-tier;
            { StackSize >= 7; Style divine-tier; }
        }
    }
    {
        HasValue %ExceptionalTier_AllflameEmber%; BaseType == %ExceptionalTier_AllflameEmber%; Style exceptional-tier;
        {
            StackSize >= 2; Style divine-tier;
            { StackSize >= 20; Style mirror-tier; }
        }
    }
    {
        HasValue %DivineTier_AllflameEmber%; BaseType == %DivineTier_AllflameEmber%; Style divine-tier;
        { StackSize >= 10; Style mirror-tier; }
    }
    { HasValue %MirrorTier_AllflameEmber%; BaseType == %MirrorTier_AllflameEmber%; Style mirror-tier; }
]
