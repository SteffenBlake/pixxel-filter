# Cheap or unpriced bases retain the existing rarity and unidentified-tier rules.
# Baseline rules deliberately have no influence condition; known influences follow.
[
    Rarity < Unique;
    ItemLevel >= 82;
    Corrupted False;
    Mirrored False;
    Style gear;

    [
        {
            HasValue %ValuableTier_Normal_Any_Bases%;
            LinkedSockets < 6;
            BaseType == %ValuableTier_Normal_Any_Bases%;
            Style valuable-tier;
        }
        {
            HasValue %ExceptionalTier_Normal_Any_Bases%;
            BaseType == %ExceptionalTier_Normal_Any_Bases%;
            Style exceptional-tier;
        }
        [
            ItemLevel >= 83;
            {
                HasValue %ValuableTier_Normal_83_Bases%;
                LinkedSockets < 6;
                BaseType == %ValuableTier_Normal_83_Bases%;
                Style valuable-tier;
            }
            {
                HasValue %ExceptionalTier_Normal_83_Bases%;
                BaseType == %ExceptionalTier_Normal_83_Bases%;
                Style exceptional-tier;
            }
        ]
        [
            ItemLevel >= 84;
            {
                HasValue %ValuableTier_Normal_84_Bases%;
                LinkedSockets < 6;
                BaseType == %ValuableTier_Normal_84_Bases%;
                Style valuable-tier;
