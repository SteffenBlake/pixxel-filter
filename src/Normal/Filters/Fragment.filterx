{
    Class == "Map Fragments" "Labyrinth Map Items" "Vault Keys";
    Style fragment common-tier;
}

[
    Style fragment;
    {
        HasValue %MehTier_Fragment%;
        BaseType == %MehTier_Fragment%;
        Style meh-tier;
    }
    {
        HasValue %CommonTier_Fragment%;
        BaseType == %CommonTier_Fragment%;
        Style common-tier;
        {
            StackSize >= 10;
            Style useful-tier;
        }
    }
    {
        HasValue %UsefulTier_Fragment%;
        BaseType == %UsefulTier_Fragment%;
        Style useful-tier;
        {
            StackSize >= 5;
            Style valuable-tier;
            {
                StackSize >= 15;
                Style premium-tier;
            }
        }
    }
    {
        HasValue %ValuableTier_Fragment%;
        BaseType == %ValuableTier_Fragment%;
        Style valuable-tier;
        {
            StackSize >= 3;
            Style premium-tier;
            {
                StackSize >= 10;
                Style exceptional-tier;
            }
        }
    }
    {
        HasValue %PremiumTier_Fragment%;
        BaseType == %PremiumTier_Fragment%;
        Style premium-tier;
        {
            StackSize >= 4;
            Style exceptional-tier;
            {
                StackSize >= 7;
                Style divine-tier;
            }
        }
    }
    {
        HasValue %ExceptionalTier_Fragment%;
        BaseType == %ExceptionalTier_Fragment%;
        Style exceptional-tier;
        {
            StackSize >= 2;
            Style divine-tier;
            {
                StackSize >= 20;
                Style mirror-tier;
            }
        }
    }
    {
        HasValue %DivineTier_Fragment%;
        BaseType == %DivineTier_Fragment%;
        Style divine-tier;
        {
            StackSize >= 10;
            Style mirror-tier;
        }
    }
    {
        HasValue %MirrorTier_Fragment%;
        BaseType == %MirrorTier_Fragment%;
        Style mirror-tier;
    }
]
