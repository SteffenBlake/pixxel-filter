{
    Class == "Stackable Currency" "Currency" "Delve Socketable Currency" "Delve Stackable Socketable Currency";
    Style currency meh-tier;
}

# Approximate stack value from the tier floor; at most two promotions.
# A zero meh-tier floor does not give a meaningful promotion threshold.
[
    Style currency;
    {
        HasValue %MehTier_Currency%;
        BaseType == %MehTier_Currency%;
        Style meh-tier;
    }
    {
        HasValue %CommonTier_Currency%;
        BaseType == %CommonTier_Currency%;
        Style common-tier;
        {
            StackSize >= 10;
            Style useful-tier;
        }
    }
    {
        HasValue %UsefulTier_Currency%;
        BaseType == %UsefulTier_Currency%;
        Style useful-tier;
        {
            StackSize >= 5;
            Style valuable-tier;
            {
                StackSize >= 15;
                Style premium-tier;
            }
        }
    }
    {
        HasValue %ValuableTier_Currency%;
        BaseType == %ValuableTier_Currency%;
        Style valuable-tier;
        {
            StackSize >= 3;
            Style premium-tier;
            {
                StackSize >= 10;
                Style exceptional-tier;
            }
        }
    }
    {
        HasValue %PremiumTier_Currency%;
        BaseType == %PremiumTier_Currency%;
        Style premium-tier;
        {
            StackSize >= 4;
            Style exceptional-tier;
            {
                StackSize >= 7;
                Style divine-tier;
            }
        }
    }
    {
        HasValue %ExceptionalTier_Currency%;
        BaseType == %ExceptionalTier_Currency%;
        Style exceptional-tier;
        {
            StackSize >= 2;
            Style divine-tier;
            {
                StackSize >= 20;
                Style mirror-tier;
            }
        }
    }
    {
        HasValue %DivineTier_Currency%;
        BaseType == %DivineTier_Currency%;
        Style divine-tier;
        {
            StackSize >= 10;
            Style mirror-tier;
        }
    }
    {
        HasValue %MirrorTier_Currency%;
        BaseType == %MirrorTier_Currency%;
        Style mirror-tier;
    }
]
