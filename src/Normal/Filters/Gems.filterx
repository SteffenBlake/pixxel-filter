# Baseline gem rules; retired alternate-quality gem rules are not carried over.
{
    Class == "Skill Gems" "Support Gems";
    Style gem junk-tier;
    {
        GemLevel >= 21;
        Style common-tier;
    }
    {
        Quality >= 21;
        Style common-tier;
    }
    {
        BaseType = Awakened;
        Style premium-tier;
    }
}
