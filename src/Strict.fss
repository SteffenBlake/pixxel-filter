useful-tier {
    show: true;
    font-size: 33;
    font-color-alpha: 255;
    border-color-alpha: 255;
    bg-color-alpha: 255;
}

/* Keep inherited lower-tier font overrides from changing higher tiers. */
valuable-tier {
    font-size: 36;
}
premium-tier {
    font-size: 39;
}
exceptional-tier {
    font-size: 42;
}
divine-tier {
    font-size: 45;
}
mirror-tier {
    font-size: 45;
}
special-tier {
    font-size: 36;
}
scroll-tier {
    font-size: 1;
}
